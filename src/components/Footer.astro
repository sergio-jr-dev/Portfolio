---
import Container from "./shared/Container.astro";

const currentYear = new Date().getFullYear();
---

<footer
  class="border-border bg-surface-elevated text-subtle mbe-20 mt-auto border-y py-4 text-sm sm:mbe-0 sm:border-t"
>
  <Container>
    <div
      class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-center sm:text-start"
    >
      <p>&copy; {currentYear} Sergio Jiménez Rubio</p>
      <span
        class="bg-border hidden size-1 rounded-full sm:block"
        aria-hidden="true"></span>
      <p class="text-muted font-medium">
        Construyo con criterio, claridad y atención al detalle.
      </p>
    </div>
  </Container>
</footer>
